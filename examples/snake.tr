# snake.tr — turn-based snake in pure terra (no stdlib, no arrays)
# wasd = one step · any other key = repeat last step · q quits

# ---- state ----
hx.9
hy.4
dx.1
dy.0
len.2
score.0
ox.9
oy.4
bx0.8
by0.4
bx1.7
by1.4
bx2.6
by2.4
bx3.5
by3.4
ax.5
ay.5

# ---- pick an apple cell nobody stands on ----
:spawn
rnd.ax.17
ax.+1
rnd.ay.7
ay.+1
jne.ax.hx.sp1
j.spawn
:sp1
jne.ax.bx0.sp2
jne.ay.by0.spawn
:sp2
jne.ax.bx1.sp3
jne.ay.by1.spawn
:sp3
jne.ax.bx2.sp4
jne.ay.by2.spawn
:sp4
jne.ax.bx3.sp5
jne.ay.by3.spawn
:sp5

# ---- draw a frame ----
:frame
cls.
at.0.0."####################"
at.9.0."####################"
cy.1
:sides
at.cy.0."#"
at.cy.19."#"
cy.+1
jlt.cy.9.sides
at.ay.ax."@"
jgt.len.1.d0
j.n0
:d0
at.by0.bx0."o"
:n0
jgt.len.2.d1
j.n1
:d1
at.by1.bx1."o"
:n1
jgt.len.3.d2
j.n2
:d2
at.by2.bx2."o"
:n2
jgt.len.4.d3
j.n3
:d3
at.by3.bx3."o"
:n3
at.hy.hx."O"
at.10.0."wasd step  q quit  score: "
log.score

# ---- read one key ----
key.k.
jeq.k.113.quit
jeq.k.27.quit
jeq.k.119.up
jeq.k.115.down
jeq.k.97.left
jeq.k.100.right
j.step
:up
dx.0
dy.-1
j.step
:down
dx.0
dy.1
j.step
:left
dx.-1
dy.0
j.step
:right
dx.1
dy.0

# ---- advance one step ----
:step
ox.hx
oy.hy
hx.+dx
hy.+dy
jlt.hx.1.dead
jgt.hx.18.dead
jlt.hy.1.dead
jgt.hy.8.dead
bx3.bx2
by3.by2
bx2.bx1
by2.by1
bx1.bx0
by1.by0
bx0.ox
by0.oy
jne.hx.ax.ne
jne.hy.ay.ne
j.eat
:ne
jgt.len.1.v1
j.v2
:v1
jne.hx.bx0.v2
jeq.hy.by0.dead
:v2
jgt.len.2.v3
j.v4
:v3
jne.hx.bx1.v4
jeq.hy.by1.dead
:v4
jgt.len.3.v5
j.v6
:v5
jne.hx.bx2.v6
jeq.hy.by2.dead
:v6
jgt.len.4.v7
j.ne2
:v7
jne.hx.bx3.ne2
jeq.hy.by3.dead
:ne2
j.frame

# ---- ate an apple ----
:eat
score.+1
len.+1
jgt.len.5.cap
j.grow
:cap
len.5
:grow
jge.score.10.win
j.spawn

# ---- endings ----
:dead
cls.
at.4.6."G A M E   O V E R"
at.5.6."score: "
log.score
at.7.4."press any key to close"
key.z.
q.

:win
cls.
at.4.5."Y O U   W I N ! ! !"
at.5.6."score: "
log.score
at.7.4."press any key to close"
key.z.
q.

:quit
cls.
at.4.8."bye!"
log."final score: ".score
